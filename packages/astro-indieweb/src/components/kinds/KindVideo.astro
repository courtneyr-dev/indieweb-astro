---
/**
 * Video template — video-first post.
 *
 * @example
 * ```astro
 * <KindVideo
 *   video="/media/demo.mp4"
 *   content="<p>Quick demo of the new feature.</p>"
 *   published="2026-04-11T12:00:00Z"
 * />
 * ```
 */
interface Props {
  video: string | string[];
  content?: string;
  name?: string;
  photo?: string;
  published?: string;
  url?: string;
  author?: { name: string; url?: string; photo?: string };
  category?: string[];
  syndication?: string[];
  class?: string;
}

const { video, content, name, photo, published, url, author, category, syndication, class: className } = Astro.props;
const videos = Array.isArray(video) ? video : [video];
---

<article class:list={["h-entry pk-video", className]}>
  {name && <h1 class="p-name">{name}</h1>}

  <div class="pk-video__player">
    {videos.map((src) => (
      <video class="u-video" src={src} controls poster={photo}>
        <a href={src}>Download video</a>
      </video>
    ))}
  </div>
  {photo && <img class="u-photo" src={photo} alt="" hidden />}

  {content ? (
    <div class="e-content" set:html={content} />
  ) : (
    <div class="e-content"><slot /></div>
  )}

  <footer class="pk-meta">
    {author && (
      <span class="p-author h-card">
        {author.url
          ? <a class="p-name u-url" href={author.url}>{author.name}</a>
          : <span class="p-name">{author.name}</span>}
      </span>
    )}
    {published && (
      <time class="dt-published" datetime={published}>
        {new Date(published).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
      </time>
    )}
    {url && <a class="u-url" href={url}>permalink</a>}
    {category?.map((tag) => <span class="p-category">{tag}</span>)}
    {syndication?.map((syn) => <a class="u-syndication" href={syn}>{new URL(syn).hostname}</a>)}
  </footer>
</article>
