---
/**
 * Chat template — conversation log.
 *
 * Simple content-only post, same as note but with chat-specific
 * CSS class for styling chat transcripts differently.
 *
 * @example
 * ```astro
 * <KindChat
 *   content="<p><b>Alice:</b> Hey!<br><b>Bob:</b> What's up?</p>"
 *   published="2026-04-11T14:00:00Z"
 * />
 * ```
 */
interface Props {
  content?: string;
  published?: string;
  url?: string;
  author?: { name: string; url?: string; photo?: string };
  category?: string[];
  syndication?: string[];
  class?: string;
}

const { content, published, url, author, category, syndication, class: className } = Astro.props;
---

<article class:list={["h-entry pk-chat", className]}>
  {content ? (
    <div class="e-content" set:html={content} />
  ) : (
    <div class="e-content"><slot /></div>
  )}

  <footer class="pk-meta">
    {author && (
      <span class="p-author h-card">
        {author.url
          ? <a class="p-name u-url" href={author.url}>{author.name}</a>
          : <span class="p-name">{author.name}</span>}
      </span>
    )}
    {published && (
      <time class="dt-published" datetime={published}>
        {new Date(published).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
      </time>
    )}
    {url && <a class="u-url" href={url}>permalink</a>}
    {category?.map((tag) => <span class="p-category">{tag}</span>)}
    {syndication?.map((syn) => <a class="u-syndication" href={syn}>{new URL(syn).hostname}</a>)}
  </footer>
</article>
