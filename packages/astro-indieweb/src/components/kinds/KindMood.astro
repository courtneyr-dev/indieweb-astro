---
/**
 * Mood template — emotional check-in.
 *
 * @example
 * ```astro
 * <KindMood moodLabel="Happy" moodEmoji="😊" moodRating={8} />
 * ```
 */
interface Props {
  moodLabel: string;
  moodEmoji?: string;
  moodRating?: number;
  content?: string;
  published?: string;
  url?: string;
  author?: { name: string; url?: string; photo?: string };
  category?: string[];
  syndication?: string[];
  class?: string;
}

const {
  moodLabel, moodEmoji, moodRating, content, published, url, author,
  category, syndication, class: className,
} = Astro.props;
---

<article class:list={["h-entry pk-mood", className]}>
  <div class="pk-mood__display">
    {moodEmoji && <span class="pk-mood__emoji" aria-hidden="true">{moodEmoji}</span>}
    <span class="p-name pk-mood__label">{moodLabel}</span>
    {moodRating != null && <span class="pk-mood__rating">{moodRating}/10</span>}
  </div>

  {content && <div class="e-content" set:html={content} />}

  <footer class="pk-meta">
    {author && (
      <span class="p-author h-card">
        {author.url
          ? <a class="p-name u-url" href={author.url}>{author.name}</a>
          : <span class="p-name">{author.name}</span>}
      </span>
    )}
    {published && (
      <time class="dt-published" datetime={published}>
        {new Date(published).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
      </time>
    )}
    {url && <a class="u-url" href={url}>permalink</a>}
    {category?.map((tag) => <span class="p-category">{tag}</span>)}
    {syndication?.map((syn) => <a class="u-syndication" href={syn}>{new URL(syn).hostname}</a>)}
  </footer>
</article>
