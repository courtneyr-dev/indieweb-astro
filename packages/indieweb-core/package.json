{
  "name": "@opensourcetogether/indieweb-core",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./mf2": {
      "import": "./dist/mf2/index.mjs",
      "types": "./dist/mf2/index.d.mts"
    },
    "./kinds": {
      "import": "./dist/kinds/index.mjs",
      "types": "./dist/kinds/index.d.mts"
    },
    "./xfn": {
      "import": "./dist/xfn/index.mjs",
      "types": "./dist/xfn/index.d.mts"
    },
    "./webmention": {
      "import": "./dist/webmention/index.mjs",
      "types": "./dist/webmention/index.d.mts"
    },
    "./indieauth": {
      "import": "./dist/indieauth/index.mjs",
      "types": "./dist/indieauth/index.d.mts"
    },
    "./micropub": {
      "import": "./dist/micropub/index.mjs",
      "types": "./dist/micropub/index.d.mts"
    },
    "./posse": {
      "import": "./dist/posse/index.mjs",
      "types": "./dist/posse/index.d.mts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts src/mf2/index.ts src/kinds/index.ts src/xfn/index.ts src/webmention/index.ts src/indieauth/index.ts src/micropub/index.ts src/posse/index.ts --format esm --dts --clean",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsdown": "^0.21.7",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
