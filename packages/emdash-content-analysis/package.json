{
  "name": "@opensourcetogether/emdash-content-analysis",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./sandbox": "./dist/sandbox-entry.mjs"
  },
  "files": [
    "dist"
